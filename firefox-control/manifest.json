{
  "manifest_version": 2,
  "name": "干部学院账号面板（测试版）",
  "version": "0.2.0",
  "description": "按 Firefox 容器管理学院登录；本地集中填写验证码，不保存密码。",
  "browser_specific_settings": {
    "gecko": {
      "id": "gdgbpx-control@local.helper",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo"
        ]
      }
    }
  },
  "permissions": [
    "contextualIdentities",
    "cookies",
    "storage",
    "tabs",
    "https://gbpx.gd.gov.cn/*"
  ],
  "background": {
    "scripts": [
      "controller.js",
      "background.js"
    ]
  },
  "browser_action": {
    "default_title": "打开学院账号面板"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gbpx.gd.gov.cn/gdceportal/index.aspx*"
      ],
      "js": [
        "login-content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "content_security_policy": "script-src 'self'; object-src 'none'; img-src 'self' data:; connect-src 'none'"
}